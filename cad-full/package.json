{
  "name": "convertx-cad-dwg-pdf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run test && tsc --noEmit && vite build && npm run offline:generate && npm run check:dist",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "deps:check": "node scripts/npm-failover.mjs --check",
    "deps:install": "node scripts/npm-failover.mjs",
    "deps:ci": "node scripts/npm-failover.mjs --ci",
    "check:dist": "node scripts/check-dist.mjs",
    "offline:generate": "node scripts/generate-offline-sw.mjs"
  },
  "dependencies": {
    "@mlightcad/cad-simple-viewer": "1.7.8",
    "@mlightcad/data-model": "1.15.21",
    "@mlightcad/libredwg-converter": "3.15.21",
    "@mlightcad/cad-pdf-plugin": "1.7.8",
    "@mlightcad/pdf-renderer": "1.7.8",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "vite-plugin-static-copy": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  }
}
